# Copy to .env for local development. Do not commit .env.
# On Vercel, set the same names in the project environment (Production and Preview).
# The dashboard is the production source of truth. This file is documentation only.

# Default LLM path is Ollama Cloud for every agent except review.
# LLM_PROVIDER=groq also sends those nodes to Groq.
# LLM_PROVIDER=anthropic sends every agent, including review, to Claude.
LLM_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=nemotron-3-nano

# Review agent. Also used for the other agents when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Claude API. Used when LLM_PROVIDER=anthropic. Paste your key on the first line.
# Model id for Claude Opus 5.5: https://platform.claude.com/docs/en/models/opus-5-5/overview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional OpenRouteService key. Leave empty to keep routing on curated offline data.
ORS_API_KEY=
USE_LIVE_APIS=false

MAX_REVISIONS=3
BUFFER_PCT=10
# Outbound provider calls allowed in one planner run. Live calls stay off while USE_LIVE_APIS=false.
API_CALL_BUDGET=40

# Leave empty on Vercel. Runtime cache stays off until a store is configured.
# Local options: memory:// or sqlite:///path/to/cache.sqlite
CACHE_STORE_URL=
CHECKPOINT_STORE_URL=

# Optional LangSmith tracing. Leave unset. Node traces record request length, not the text.
# LANGSMITH_TRACING=false
