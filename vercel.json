{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "planner-api",
          "format": "url",
          "env": "PLANNER_API_INTERNAL_URL"
        }
      ]
    },
    "planner-api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "services/planner-api/api/main.py",
      "installCommand": "python -m pip install -r requirements.txt -e .",
      "buildCommand": "PYTHONPATH=src python scripts/build_db.py",
      "functions": {
        "services/planner-api/api/main.py": {
          "maxDuration": 300
        }
      },
      "rewrites": [
        { "source": "/api/planner/:path(.*)?", "destination": "/:path" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/planner/(.*)",
      "destination": { "service": "planner-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
